      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie mühelos schöne, professionelle Lebensläufe. Wählen Sie aus Vorlagen oder erstellen Sie von Grund auf neu."
