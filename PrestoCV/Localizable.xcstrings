    "ai.unavailable.not_enabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ist ausgeschaltet. Öffnen Sie dafür die Einstellungen, tippen Sie auf „Apple Intelligence & Siri“ und schalten Sie Apple Intelligence ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence is turned off. To use this, open Settings, tap Apple Intelligence & Siri, and turn on Apple Intelligence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence está desactivado. Para usarlo, abre Ajustes, toca Apple Intelligence y Siri y activa Apple Intelligence."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence est désactivé. Pour l'utiliser, ouvrez Réglages, touchez Apple Intelligence et Siri, puis activez Apple Intelligence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence è disattivato. Per usarlo, apri Impostazioni, tocca Apple Intelligence e Siri e attiva Apple Intelligence."
          }
        },
        "pt" : {
