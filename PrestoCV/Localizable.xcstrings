    "ai.generation.prompt_instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nennen Sie, was in Ihren Lebenslauf soll: Name, Kontaktdaten, Stationen, Ausbildung, Fähigkeiten, Sprachen. Was Sie weglassen, bleibt leer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mention what you want on your CV: name, contact details, jobs, studies, skills, languages. Anything you leave out stays blank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menciona lo que quieres en tu CV: nombre, datos de contacto, trabajos, estudios, habilidades, idiomas. Lo que no incluyas queda en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez ce que vous voulez dans votre CV : nom, coordonnées, emplois, études, compétences, langues. Ce que vous omettez reste vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica cosa vuoi nel tuo CV: nome, contatti, lavori, studi, competenze, lingue. Ciò che non indichi resta vuoto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencione o que você quer no seu currículo: nome, contatos, trabalhos, estudos, habilidades, idiomas. O que você deixar de fora fica em branco."
          }
        }
      }
    },
