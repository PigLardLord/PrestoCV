        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Intelligence não consegue escrever a partir deste texto. Altere sua descrição e tente novamente."
          }
        }
      }
    },
    "ai.error.empty_result" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
