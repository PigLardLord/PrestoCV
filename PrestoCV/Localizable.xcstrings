        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi il tuo percorso con parole tue. L'IA scrive il tuo CV su questo dispositivo e tu controlli tutto prima di salvare."
          }
        },
        "pt" : {
