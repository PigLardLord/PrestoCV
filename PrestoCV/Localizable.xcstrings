    "ai.error.content_not_allowed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kann aus diesem Text nichts erstellen. Bitte ändern Sie Ihre Beschreibung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence can't write from this text. Please change your description and try again."
