{
 "_comment": "Architecture rules of the repository (ADR 0006, ADR 0021). Rules are named as in docs/architecture/rules.md. The rules map lists the detectors of each rule, and a target's rules list names the rules whose detectors run on it. Every Swift file belongs to exactly one target. Legacy targets are exempt until deleted (ADR 0012); targets listed in modules.md but not built yet are in notYetImplemented.",
 "rules": {
  "DependencyRule": [
   "exportedImport"
  ],
  "PureCore": [
   "wallClock",
   "randomIdentity",
   "ambientEnvironment",
   "localization",
   "printing"
  ],
  "DIP": [
   "singleton",
   "infrastructureConstruction"
  ],
  "ISP": [
   "protocolSize"
  ],
  "CleanFunctions": [
   "functionLength",
   "parameterCount",
   "nestingDepth",
   "cyclomaticComplexity"
  ],
  "CleanTypes": [
   "typeLength",
   "fileLength"
  ],
  "CleanComments": [
   "ruleNumberCitation"
  ],
  "CleanErrors": [
   "swallowedError"
  ],
  "StrictConcurrency": [
   "escapeHatch",
   "swift5Mode",
   "unsafeFlags"
  ],
  "PlatformAdapters": [
   "platformCondition"
  ],
  "LocalisationAtEdges": [
   "localization"
  ],
  "NoDeadCode": [
   "printing",
   "testDouble"
  ]
 },
 "infrastructureTypes": [
  "FileCVRepository",
  "FileDesignStore",
  "BundleDesignSource",
  "IOSPDFRenderer",
  "MacPDFRenderer",
  "FoundationModelsDrafter"
 ],
 "exceptions": [],
 "notYetImplemented": [
  "App/",
  "Features/",
  "DesignSystem/",
  "Platform/",
  "Resources/"
 ],
