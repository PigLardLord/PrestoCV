    "editor.note.email" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gespeichert: Geben Sie die ganze E-Mail-Adresse ein, zum Beispiel name@example.com."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not saved: write the whole email address, such as name@example.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha guardado: escribe la dirección de correo completa, como nombre@example.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non enregistré : saisissez l’adresse e-mail complète, par exemple nom@example.com."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
