          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo salió mal al iniciar la app. Inténtalo de nuevo o cierra la app y ábrela otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
