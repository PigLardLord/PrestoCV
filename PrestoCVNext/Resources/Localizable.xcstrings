          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não guardado: escreve o endereço de e-mail completo, por exemplo nome@example.com."
          }
        }
      }
    },
    "editor.note.phone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gespeichert: Geben Sie nur die Nummer ein, mit mindestens drei Ziffern, zum Beispiel +1 555 0100."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not saved: write only the number, with at least three digits, such as +1 555 0100."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha guardado: escribe solo el número, con al menos tres dígitos, como +1 555 0100."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non enregistré : saisissez uniquement le numéro, avec au moins trois chiffres, par exemple +1 555 0100."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non salvato: scrivi solo il numero, con almeno tre cifre, per esempio +1 555 0100."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não guardado: escreve só o número, com pelo menos três algarismos, por exemplo +1 555 0100."
          }
        }
      }
    },
