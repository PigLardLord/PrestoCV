    "editor.notice.conflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Neu laden“ zeigt die gespeicherte Fassung und verwirft Ihre Änderungen hier. „Als Kopie speichern“ behält sie in einem neuen Lebenslauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reload” shows the stored version and drops your changes here. “Save as a copy” keeps them in a new CV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Volver a cargar» muestra la versión guardada y descarta tus cambios aquí. «Guardar como copia» los conserva en un CV nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Recharger » affiche la version enregistrée et abandonne vos modifications ici. « Enregistrer une copie » les garde dans un nouveau CV."
          }
        },
        "it" : {
          "stringUnit" : {
