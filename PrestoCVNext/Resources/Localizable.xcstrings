    "failed.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Start der App ist ein Fehler aufgetreten. Versuchen Sie es erneut oder schließen Sie die App und öffnen Sie sie neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong while starting the app. Try again, or close the app and open it again."
          }
        },
