    "editor.notice.conflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Neu laden“ zeigt die gespeicherte Fassung und verwirft Ihre Änderungen hier. „Als Kopie speichern“ behält sie in einem neuen Lebenslauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reload” shows the stored version and drops your changes here. “Save as a copy” keeps them in a new CV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Volver a cargar» muestra la versión guardada y descarta tus cambios aquí. «Guardar como copia» los conserva en un CV nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Recharger » affiche la version enregistrée et abandonne vos modifications ici. « Enregistrer une copie » les garde dans un nouveau CV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ricarica” mostra la versione salvata e scarta le tue modifiche qui. “Salva come copia” le tiene in un nuovo CV."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Recarregar” mostra a versão salva e descarta suas alterações aqui. “Salvar como cópia” as mantém em um novo CV."
          }
        }
      }
    },
    "editor.notice.deletedElsewhere" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Kopie speichern“ behält Ihren Text in einem neuen Lebenslauf. „Verwerfen“ schließt ihn, ohne zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Save as a copy” keeps your text in a new CV. “Discard” closes it without saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Guardar como copia» conserva tu texto en un CV nuevo. «Descartar» lo cierra sin guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Enregistrer une copie » garde votre texte dans un nouveau CV. « Abandonner » le ferme sans enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Salva come copia” tiene il testo in un nuovo CV. “Scarta” lo chiude senza salvare."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Salvar como cópia” mantém seu texto em um novo CV. “Descartar” o fecha sem salvar."
          }
        }
      }
    },
