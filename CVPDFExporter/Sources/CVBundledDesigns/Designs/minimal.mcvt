{
  "manifest": {
    "id": "minimal",
    "name": "Minimal",
    "version": "1.3.0",
    "description": "Plain, airy layout that lets the content speak, with no rules or boxes.",
    "defaultPalette": "ink",
    "defaultFonts": "system",
    "markupContract": 2,
    "author": "PrestoCV",
    "price": 0.0
  },
  "cssContent": ".cv { background-color: var(--color-background); color: var(--color-text); font-family: var(--font-body); font-size: 10pt; line-height: 1.6; padding: 24pt 48pt 0; }\n.cv-header { margin-bottom: 20pt; }\n.cv-name { font-family: var(--font-heading); font-size: 24pt; font-weight: 400; margin-bottom: 2pt; }\n.cv-title { font-size: 12pt; color: var(--color-primary); margin-bottom: 4pt; }\n.cv-contact, .cv-phone, .cv-location, .cv-website { font-size: 9pt; }\n.cv-website { color: var(--color-text); text-decoration: none; }\n.cv-section { margin-bottom: 16pt; }\n.cv-section-title { font-family: var(--font-heading); color: var(--color-primary); font-size: 10pt; font-weight: 700; text-transform: uppercase; letter-spacing: 2pt; margin-bottom: 6pt; }\n.cv-entry-title { font-size: 10.5pt; font-weight: 700; }\n.cv-entry-subtitle { font-style: italic; }\n.cv-entry-location, .cv-entry-period { font-size: 9pt; color: var(--color-primary); }\n.cv-entry-link { font-size: 9pt; color: var(--color-text); }\n.cv-skill, .cv-interest { display: inline-block; margin: 0 8pt 3pt 0; }\n.cv-language-level { margin-left: 4pt; font-style: italic; }\n\n.cv-entry { break-inside: avoid; margin-bottom: 9pt; }\n.cv-entry-description { margin-top: 3pt; }\n.cv-summary { margin-bottom: 4pt; }\n.cv-language { margin-bottom: 3pt; }\n.cv-profile { display: block; margin-bottom: 3pt; color: var(--color-text); text-decoration: none; }\n.cv-profile-platform { font-weight: bold; margin-right: 6pt; }\n",
  "previewImageBase64": ""
}
