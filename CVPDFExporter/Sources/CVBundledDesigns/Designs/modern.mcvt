{
  "manifest": {
    "id": "modern",
    "name": "Modern",
    "version": "1.3.0",
    "description": "Contemporary layout with a large name, a colour accent bar and spaced-out section titles.",
    "defaultPalette": "ocean",
    "defaultFonts": "system",
    "markupContract": 2,
    "author": "PrestoCV",
    "price": 0.0
  },
  "cssContent": ".cv { background-color: var(--color-background); color: var(--color-text); font-family: var(--font-body); font-size: 10pt; line-height: 1.55; padding: 24pt 44pt 0; }\n.cv-header { border-left: 4pt solid var(--color-primary); padding-left: 12pt; margin-bottom: 20pt; }\n.cv-name { font-family: var(--font-heading); color: var(--color-primary); font-size: 30pt; font-weight: 300; letter-spacing: 1pt; margin-bottom: 2pt; }\n.cv-title { font-family: var(--font-heading); font-size: 13pt; text-transform: uppercase; letter-spacing: 2pt; margin-bottom: 6pt; }\n.cv-contact, .cv-phone, .cv-location, .cv-website { font-size: 9pt; }\n.cv-website { color: var(--color-primary); text-decoration: none; }\n.cv-section { margin-bottom: 16pt; }\n.cv-section-title { font-family: var(--font-heading); color: var(--color-primary); font-size: 12pt; font-weight: 700; text-transform: uppercase; letter-spacing: 2pt; margin-bottom: 8pt; }\n.cv-entry { border-left: 2pt solid var(--color-primary); padding-left: 10pt; }\n.cv-entry-title { font-family: var(--font-heading); font-size: 11pt; font-weight: 600; }\n.cv-entry-subtitle { color: var(--color-primary); }\n.cv-entry-location, .cv-entry-period { font-size: 9pt; }\n.cv-entry-link { font-size: 9pt; color: var(--color-primary); }\n.cv-skill, .cv-interest { display: inline-block; border: 1pt solid var(--color-primary); border-radius: 12pt; padding: 1pt 9pt; margin: 0 4pt 5pt 0; font-size: 9pt; }\n.cv-language-level { color: var(--color-primary); margin-left: 4pt; }\n\n.cv-entry { break-inside: avoid; margin-bottom: 9pt; }\n.cv-entry-description { margin-top: 3pt; }\n.cv-summary { margin-bottom: 4pt; }\n.cv-language { margin-bottom: 3pt; }\n.cv-profile { display: block; margin-bottom: 3pt; color: var(--color-text); text-decoration: none; }\n.cv-profile-platform { font-weight: bold; margin-right: 6pt; }\n",
  "previewImageBase64": ""
}
