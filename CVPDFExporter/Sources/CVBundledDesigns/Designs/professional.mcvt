{
  "manifest": {
    "id": "professional",
    "name": "Professional",
    "version": "1.2.0",
    "description": "Clean corporate layout with a ruled header and underlined section titles.",
    "defaultPalette": "slate",
    "defaultFonts": "system",
    "markupContract": 1,
    "author": "PrestoCV",
    "price": 0.0
  },
  "cssContent": ".cv { background-color: var(--color-background); color: var(--color-text); font-family: var(--font-body); font-size: 10pt; line-height: 1.5; padding: 24pt 40pt; }\n.cv-header { border-bottom: 3pt solid var(--color-primary); padding-bottom: 12pt; margin-bottom: 16pt; }\n.cv-name { font-family: var(--font-heading); color: var(--color-primary); font-size: 26pt; font-weight: 700; margin-bottom: 2pt; }\n.cv-title { font-size: 13pt; margin-bottom: 4pt; }\n.cv-contact, .cv-phone, .cv-location, .cv-website { font-size: 9pt; }\n.cv-website { color: var(--color-text); text-decoration: none; }\n.cv-section { margin-bottom: 14pt; }\n.cv-section-title { font-family: var(--font-heading); color: var(--color-primary); font-size: 13pt; font-weight: 700; text-transform: uppercase; letter-spacing: 1pt; border-bottom: 1pt solid var(--color-primary); padding-bottom: 2pt; margin-bottom: 8pt; }\n.cv-entry-title { font-family: var(--font-heading); font-size: 11pt; font-weight: 700; }\n.cv-entry-subtitle { color: var(--color-primary); font-weight: 600; }\n.cv-entry-location, .cv-entry-period { font-size: 9pt; font-style: italic; }\n.cv-entry-link { font-size: 9pt; color: var(--color-primary); }\n.cv-skill, .cv-interest { display: inline-block; border: 1pt solid var(--color-primary); border-radius: 3pt; padding: 1pt 6pt; margin: 0 4pt 4pt 0; font-size: 9pt; }\n.cv-language-level { font-style: italic; margin-left: 4pt; }\n\n.cv-entry { break-inside: avoid; margin-bottom: 9pt; }\n.cv-entry-description { margin-top: 3pt; }\n.cv-section-title { break-after: avoid; }\n.cv-summary { margin-bottom: 4pt; }\n.cv-language { margin-bottom: 3pt; }\n.cv-profile { display: block; margin-bottom: 3pt; color: var(--color-text); text-decoration: none; }\n.cv-profile-platform { font-weight: bold; margin-right: 6pt; }\n",
  "previewImageBase64": ""
}
