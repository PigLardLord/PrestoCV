{
  "manifest": {
    "id": "minimal",
    "name": "Minimal",
    "version": "1.0.5",
    "description": "Simple and clean design focusing on content",
    "author": "PrestoCV",
    "previewImage": "preview.png",
    "price": 0.0
  },
  "cssContent": "* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\n:root {\n    --color-primary: {{colorPrimary}};\n    --color-secondary: {{colorSecondary}};\n    --color-accent: {{colorAccent}};\n    --color-background: {{colorBackground}};\n    --color-text: {{colorText}};\n    --font-heading: {{fontHeading}};\n    --font-body: {{fontBody}};\n    --font-size: {{fontSize}};\n    --spacing-xs: 8pt;\n    --spacing-sm: 12pt;\n    --spacing-md: 20pt;\n    --spacing-lg: 30pt;\n    --spacing-xl: 40pt;\n}\n\nbody {\n    font-family: var(--font-body);\n    font-size: var(--font-size);\n    color: var(--color-text);\n    background: var(--color-background);\n    line-height: 1.45;\n    max-width: 700pt;\n    margin: 0 auto;\n}\n\n/* Header - Clean and simple */\nheader {\n    text-align: center;\n    margin-bottom: var(--spacing-lg);\n    padding-bottom: var(--spacing-md);\n    border-bottom: 1pt solid var(--color-text);\n}\n\nh1 {\n    font-family: var(--font-heading);\n    font-size: 20pt;\n    font-weight: normal;\n    letter-spacing: 1pt;\n    margin-bottom: var(--spacing-xs);\n}\n\n.header-title {\n    font-size: 11pt;\n    letter-spacing: 0.5pt;\n    color: var(--color-secondary);\n}\n\n.contact-info {\n    font-size: 10pt;\n    color: var(--color-secondary);\n    margin-top: var(--spacing-xs);\n}\n\n/* The details are set apart by space and not by a mark: a mark between two of them could be left at the end of\n   a line, or start the next one, when the line wraps. A detail is not split unless it is longer than the line. */\n.contact-info span {\n    display: inline-block;\n    max-width: 100%;\n    margin: 0 var(--spacing-sm);\n    overflow-wrap: anywhere;\n}\n\n.summary {\n    white-space: pre-line;\n    font-style: italic;\n    text-align: center;\n    margin-bottom: var(--spacing-lg);\n    padding: 0 var(--spacing-xl);\n    break-inside: avoid;\n    page-break-inside: avoid;\n    color: var(--color-secondary);\n}\n\n/* Content sections */\n/* Sections and entries flow from one page to the next, so that a page is filled before it ends.\n   The space between blocks is above a block, never below it: the end of the CV then has no margin\n   that could push an empty page out. An entry is one block of inline content, and the print renderer\n   keeps its first four lines and its last three together: the title of the section, which is the first line\n   of the first entry, never stays alone at the foot of a page. A small section is kept whole. */\n.section + .section {\n    margin-top: var(--spacing-lg);\n}\n\n.section-whole {\n    break-inside: avoid;\n    page-break-inside: avoid;\n}\n\nh2,\n.section-title {\n    font-family: var(--font-heading);\n    font-size: 12pt;\n    font-weight: normal;\n    letter-spacing: 0.5pt;\n    margin-bottom: var(--spacing-sm);\n    padding-bottom: var(--spacing-xs);\n    border-bottom: 0.5pt solid var(--color-text);\n}\n\n/* The title of a section that is printed as the first line of its first entry */\n.section-title {\n    display: inline-block;\n    width: 100%;\n}\n\n.item {\n    orphans: 4;\n    widows: 3;\n}\n\n.item + .item {\n    margin-top: var(--spacing-md);\n}\n\n.item-title {\n    font-weight: 600;\n    color: var(--color-primary);\n}\n\n.item-subtitle {\n    color: var(--color-secondary);\n    font-style: italic;\n}\n\n.item-date {\n    float: right;\n    margin-left: var(--spacing-sm);\n    color: var(--color-secondary);\n    font-size: 9pt;\n    white-space: nowrap;\n}\n\n.item-description {\n    white-space: pre-line;\n    text-align: start;\n}\n\n.item-location {\n    color: var(--color-secondary);\n    font-size: 9pt;\n}\n\n.cert-url,\n.item-value {\n    overflow-wrap: anywhere;\n}\n\n.cert-url {\n    color: var(--color-secondary);\n    font-size: 9pt;\n}\n\n/* The rating of a skill stays whole, and with the last word of its name */\n.skill-level {\n    color: var(--color-primary);\n    font-size: 9pt;\n    letter-spacing: 0.3pt;\n    white-space: nowrap;\n}\n\n/* Skills - Simple list style */\n.skills-list {\n    display: inline;\n    margin-left: var(--spacing-xs);\n}\n\n.skill {\n    display: inline;\n    color: var(--color-secondary);\n}\n\n.skill:after {\n    content: \", \";\n}\n\n.skill:last-child:after {\n    content: \"\";\n}\n\n/* Languages, Certifications, Social Links, Interests */\n.simple-item {\n    break-inside: avoid;\n    page-break-inside: avoid;\n}\n\n.simple-item + .simple-item {\n    margin-top: var(--spacing-xs);\n}\n\n.item-label {\n    font-weight: 600;\n    color: var(--color-primary);\n}\n\n.item-value {\n    color: var(--color-secondary);\n}\n\n.interests {\n    color: var(--color-secondary);\n}\n\n.interest:after {\n    content: \", \";\n}\n\n.interest:last-child:after {\n    content: \"\";\n}\n\n/* Print styles */\n@media print {\n    body {\n        padding: 0;\n        max-width: 100%;\n    }\n\n}",
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"{{lang}}\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{name}} - CV</title>\n    <style>\n        {{customCSS}}\n    </style>\n</head>\n<body>\n    <header>\n        <h1>{{name}}</h1>\n        {{#hasTitle}}\n        <div class=\"header-title\">{{title}}</div>\n        {{/hasTitle}}\n        <div class=\"contact-info\">\n            {{#email}}\n            <span>{{email}}</span>\n            {{/email}}\n            {{#hasPhone}}\n            <span>{{phone}}</span>\n            {{/hasPhone}}\n            {{#hasLocation}}\n            <span>{{location}}</span>\n            {{/hasLocation}}\n            {{#hasWebsite}}\n            <span>{{website}}</span>\n            {{/hasWebsite}}\n        </div>\n    </header>\n\n    {{#hasSummary}}\n    <div class=\"summary\">{{summary}}</div>\n    {{/hasSummary}}\n\n    {{#hasWorkExperience}}\n    <section class=\"section\">\n        {{#workExperience}}\n        <div class=\"item\">\n            {{#isFirst}}<span class=\"section-title\">{{i18n_work_experience}}</span>{{/isFirst}}\n            {{#period}}<span class=\"item-date\">{{period}}</span>{{/period}}\n            <span class=\"item-title\">{{title}}</span>\n            {{#company}}<span class=\"item-subtitle\">— {{company}}</span>{{/company}}\n            {{#location}}<br><span class=\"item-location\">{{location}}</span>{{/location}}\n            {{#description}}<br><span class=\"item-description\">{{description}}</span>{{/description}}\n        </div>\n        {{/workExperience}}\n    </section>\n    {{/hasWorkExperience}}\n\n    {{#hasEducation}}\n    <section class=\"section\">\n        {{#education}}\n        <div class=\"item\">\n            {{#isFirst}}<span class=\"section-title\">{{i18n_education}}</span>{{/isFirst}}\n            {{#period}}<span class=\"item-date\">{{period}}</span>{{/period}}\n            <span class=\"item-title\">{{degree}}</span>\n            {{#school}}<span class=\"item-subtitle\">— {{school}}</span>{{/school}}\n            {{#description}}<br><span class=\"item-description\">{{description}}</span>{{/description}}\n        </div>\n        {{/education}}\n    </section>\n    {{/hasEducation}}\n\n    {{#hasSkills}}\n    <section class=\"section section-whole\">\n        <h2>{{i18n_skills}}</h2>\n        <div class=\"skills-group\">\n            <span class=\"skills-list\">\n                {{#skills}}<span class=\"skill\">{{name}}{{#hasLevel}}&nbsp;<span class=\"skill-level\">{{levelDots}}</span>{{/hasLevel}}</span>{{/skills}}\n            </span>\n        </div>\n    </section>\n    {{/hasSkills}}\n\n    {{#hasCertifications}}\n    <section class=\"section\">\n        {{#certifications}}\n        <div class=\"simple-item\">\n            {{#isFirst}}<span class=\"section-title\">{{i18n_certifications}}</span>{{/isFirst}}\n            <span class=\"item-label\">{{title}}</span>{{#issuer}} — <span class=\"item-value\">{{issuer}}</span>{{/issuer}}{{#date}} ({{date}}){{/date}}\n            {{#url}}<br><span class=\"cert-url\">{{url}}</span>{{/url}}\n            {{#description}}<br><span class=\"item-description\">{{description}}</span>{{/description}}\n        </div>\n        {{/certifications}}\n    </section>\n    {{/hasCertifications}}\n\n    {{#hasLanguages}}\n    <section class=\"section section-whole\">\n        <h2>{{i18n_languages}}</h2>\n        {{#languages}}\n        <div class=\"simple-item\">\n            <span class=\"item-label\">{{language}}</span>{{#level}} — <span class=\"item-value\">{{level}}</span>{{/level}}\n        </div>\n        {{/languages}}\n    </section>\n    {{/hasLanguages}}\n\n    {{#hasSocialLinks}}\n    <section class=\"section section-whole\">\n        <h2>{{i18n_social_links}}</h2>\n        {{#socialLinks}}\n        <div class=\"simple-item\">\n            <span class=\"item-label\">{{platform}}</span>{{#url}}: <span class=\"item-value\">{{url}}</span>{{/url}}\n        </div>\n        {{/socialLinks}}\n    </section>\n    {{/hasSocialLinks}}\n\n    {{#hasInterests}}\n    <section class=\"section section-whole\">\n        <h2>{{i18n_interests}}</h2>\n        <div class=\"interests\">\n            {{#interests}}<span class=\"interest\">{{.}}</span>{{/interests}}\n        </div>\n    </section>\n    {{/hasInterests}}\n</body>\n</html>",
  "previewImageBase64": ""
}