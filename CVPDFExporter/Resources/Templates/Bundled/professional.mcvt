{
  "manifest": {
    "id": "professional",
    "name": "Professional",
    "version": "1.0.1",
    "description": "Clean and professional template suitable for corporate positions",
    "author": "PrestoCV",
    "previewImage": "preview.png",
    "price": 0.0
  },
  "cssContent": "* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\n:root {\n    --color-primary: {{colorPrimary}};\n    --color-secondary: {{colorSecondary}};\n    --color-accent: {{colorAccent}};\n    --color-background: {{colorBackground}};\n    --color-text: {{colorText}};\n    --color-text-light: #7F8C8D;\n    --font-heading: {{fontHeading}};\n    --font-body: {{fontBody}};\n    --font-size: {{fontSize}};\n    --spacing-sm: 10pt;\n    --spacing-md: 15pt;\n    --spacing-lg: 20pt;\n    --spacing-xl: 30pt;\n}\n\nbody {\n    font-family: var(--font-body);\n    font-size: var(--font-size);\n    color: var(--color-text);\n    background: var(--color-background);\n    line-height: 1.6;\n    padding: 40pt;\n}\n\nheader {\n    border-bottom: 3pt solid var(--color-primary);\n    padding-bottom: var(--spacing-lg);\n    margin-bottom: var(--spacing-xl);\n}\n\nh1 {\n    font-family: var(--font-heading);\n    color: var(--color-primary);\n    font-size: 24pt;\n    font-weight: 700;\n    margin-bottom: 5pt;\n}\n\n.contact-info {\n    color: var(--color-secondary);\n    font-size: 9pt;\n    margin-top: 5pt;\n}\n\n.contact-info span {\n    display: inline-block;\n    margin-right: 15pt;\n}\n\n.summary p {\n    white-space: pre-line;\n}\n\n.summary {\n    margin-bottom: var(--spacing-xl);\n    padding: var(--spacing-md);\n    background-color: #F8F9FA;\n    border-left: 3pt solid var(--color-accent);\n}\n\n.section {\n    margin-bottom: var(--spacing-xl);\n    page-break-inside: avoid;\n}\n\nh2 {\n    font-family: var(--font-heading);\n    color: var(--color-primary);\n    font-size: 14pt;\n    font-weight: 600;\n    border-bottom: 1pt solid #E0E0E0;\n    padding-bottom: 5pt;\n    margin-bottom: var(--spacing-md);\n    text-transform: uppercase;\n}\n\n.item {\n    margin-bottom: var(--spacing-lg);\n    page-break-inside: avoid;\n}\n\n.item-header {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 5pt;\n}\n\n.item-title {\n    font-weight: 600;\n    color: var(--color-primary);\n}\n\n.item-subtitle {\n    color: var(--color-accent);\n    font-weight: 500;\n}\n\n.item-date {\n    color: var(--color-text-light);\n    font-size: 9pt;\n    font-style: italic;\n}\n\n.item-description {\n    white-space: pre-line;\n    margin-top: 5pt;\n    text-align: justify;\n}\n\n.skills-group {\n    margin-bottom: var(--spacing-md);\n}\n\n\n.skills-list {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8pt;\n}\n\n.skill-tag {\n    background-color: #ECF0F1;\n    padding: 3pt 8pt;\n    border-radius: 3pt;\n    font-size: 9pt;\n}\n\n.language-item, .cert-item, .social-item {\n    margin-bottom: 8pt;\n}\n\n.language-name, .cert-title, .social-platform {\n    font-weight: 600;\n    color: var(--color-primary);\n}\n\n.language-level, .cert-issuer, .social-url {\n    color: var(--color-secondary);\n    font-size: 9pt;\n}\n\n.interests-list {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8pt;\n}\n\n.interest-tag {\n    background-color: #ECF0F1;\n    padding: 3pt 8pt;\n    border-radius: 3pt;\n    font-size: 9pt;\n}\n\n.header-title {\n    color: var(--color-secondary);\n    font-size: 12pt;\n    font-weight: 500;\n}\n\n.item-location {\n    color: var(--color-text-light);\n    font-size: 9pt;\n}\n\n.cert-url {\n    color: var(--color-secondary);\n    font-size: 9pt;\n    word-break: break-all;\n}\n\n.skill-level {\n    font-family: monospace;\n    font-size: 8pt;\n    letter-spacing: 0.3pt;\n    color: var(--color-primary);\n}\n\n@media print {\n    body {\n        padding: 0;\n    }\n    .summary {\n        background-color: #F8F9FA !important;\n        -webkit-print-color-adjust: exact;\n        print-color-adjust: exact;\n    }\n    .skill-tag {\n        background-color: #ECF0F1 !important;\n        -webkit-print-color-adjust: exact;\n        print-color-adjust: exact;\n    }\n}",
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"{{lang}}\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{name}} - CV</title>\n    <style>\n        {{customCSS}}\n    </style>\n</head>\n<body>\n    <header>\n        <h1>{{name}}</h1>\n        {{#hasTitle}}\n        <div class=\"header-title\">{{title}}</div>\n        {{/hasTitle}}\n        <div class=\"contact-info\">\n            {{#email}}<span>{{email}}</span>{{/email}}\n            {{#hasPhone}}<span>{{phone}}</span>{{/hasPhone}}\n            {{#hasLocation}}<span>{{location}}</span>{{/hasLocation}}\n            {{#hasWebsite}}<span>{{website}}</span>{{/hasWebsite}}\n        </div>\n    </header>\n\n    {{#hasSummary}}\n    <section class=\"summary\">\n        <p>{{summary}}</p>\n    </section>\n    {{/hasSummary}}\n\n    {{#hasWorkExperience}}\n    <section class=\"section\">\n        <h2>{{i18n_work_experience}}</h2>\n        {{#workExperience}}\n        <div class=\"item\">\n            <div class=\"item-header\">\n                <div>\n                    <span class=\"item-title\">{{title}}</span>\n                    {{#company}}<span class=\"item-subtitle\">{{i18n_at}} {{company}}</span>{{/company}}\n                </div>\n                {{#period}}<span class=\"item-date\">{{period}}</span>{{/period}}\n            </div>\n            {{#location}}<div class=\"item-location\">{{location}}</div>{{/location}}\n            {{#description}}<div class=\"item-description\">{{description}}</div>{{/description}}\n        </div>\n        {{/workExperience}}\n    </section>\n    {{/hasWorkExperience}}\n\n    {{#hasEducation}}\n    <section class=\"section\">\n        <h2>{{i18n_education}}</h2>\n        {{#education}}\n        <div class=\"item\">\n            <div class=\"item-header\">\n                <div>\n                    <span class=\"item-title\">{{degree}}</span>\n                </div>\n                {{#period}}<span class=\"item-date\">{{period}}</span>{{/period}}\n            </div>\n            {{#school}}<div class=\"item-subtitle\">{{school}}</div>{{/school}}\n            {{#description}}<div class=\"item-description\">{{description}}</div>{{/description}}\n        </div>\n        {{/education}}\n    </section>\n    {{/hasEducation}}\n\n    {{#hasSkills}}\n    <section class=\"section\">\n        <h2>{{i18n_skills}}</h2>\n        <div class=\"skills-group\">\n            <div class=\"skills-list\">\n                {{#skills}}\n                <span class=\"skill-tag\">{{name}}{{#hasLevel}} <span class=\"skill-level\">{{levelDots}}</span>{{/hasLevel}}</span>\n                {{/skills}}\n            </div>\n        </div>\n    </section>\n    {{/hasSkills}}\n\n    {{#hasCertifications}}\n    <section class=\"section\">\n        <h2>{{i18n_certifications}}</h2>\n        {{#certifications}}\n        <div class=\"cert-item\">\n            <div class=\"cert-title\">{{title}}</div>\n            {{#issuer}}<div class=\"cert-issuer\">{{issuer}}</div>{{/issuer}}\n            {{#date}}<div class=\"cert-issuer\">{{date}}</div>{{/date}}\n            {{#url}}<div class=\"cert-url\">{{url}}</div>{{/url}}\n            {{#description}}<div class=\"item-description\">{{description}}</div>{{/description}}\n        </div>\n        {{/certifications}}\n    </section>\n    {{/hasCertifications}}\n\n    {{#hasLanguages}}\n    <section class=\"section\">\n        <h2>{{i18n_languages}}</h2>\n        {{#languages}}\n        <div class=\"language-item\">\n            <span class=\"language-name\">{{language}}</span>\n            {{#level}}<span class=\"language-level\"> — {{level}}</span>{{/level}}\n        </div>\n        {{/languages}}\n    </section>\n    {{/hasLanguages}}\n\n    {{#hasSocialLinks}}\n    <section class=\"section\">\n        <h2>{{i18n_social_links}}</h2>\n        {{#socialLinks}}\n        <div class=\"social-item\">\n            <div class=\"social-platform\">{{platform}}</div>\n            {{#url}}<div class=\"social-url\">{{url}}</div>{{/url}}\n        </div>\n        {{/socialLinks}}\n    </section>\n    {{/hasSocialLinks}}\n\n    {{#hasInterests}}\n    <section class=\"section\">\n        <h2>{{i18n_interests}}</h2>\n        <div class=\"interests-list\">\n            {{#interests}}\n            <span class=\"interest-tag\">{{.}}</span>\n            {{/interests}}\n        </div>\n    </section>\n    {{/hasInterests}}\n</body>\n</html>",
  "previewImageBase64": ""
}