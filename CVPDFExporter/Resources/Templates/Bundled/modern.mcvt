{
  "manifest": {
    "id": "modern",
    "name": "Modern",
    "version": "1.0.1",
    "description": "Contemporary design with clean lines and modern typography",
    "author": "PrestoCV",
    "previewImage": "preview.png",
    "price": 0.0
  },
  "cssContent": "html {\n    -webkit-text-size-adjust: 100%;\n    text-size-adjust: 100%;\n}\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n    -webkit-print-color-adjust: exact !important;\n    color-adjust: exact !important;\n    print-color-adjust: exact !important;\n}\n\n@page {\n    size: A4;\n    margin: 0.6in 0.5in;\n}\n\nbody {\n    font-family: {{fontBody}};\n    font-size: {{fontSize}};\n    line-height: 1.3;\n    color: {{colorText}};\n    background: white;\n}\n\n.container {\n    padding: 0 4pt;\n}\n\n/* Hero Section */\n.hero-section {\n    background: white;\n    padding: 0 0 10pt 0;\n    margin-bottom: 10pt;\n    border-bottom: 2pt solid #e5e7eb;\n    page-break-inside: avoid;\n}\n\n.hero-content {\n    display: grid;\n    grid-template-columns: 2fr 1fr;\n    gap: 12pt;\n    align-items: start;\n}\n\n.hero-text {\n    padding-right: 4pt;\n}\n\n.hero-name {\n    font-size: 24pt;\n    font-weight: 800;\n    color: {{colorPrimary}};\n    margin-bottom: 3pt;\n    line-height: 1.0;\n    letter-spacing: -0.5pt;\n}\n\n.hero-title {\n    font-size: 12pt;\n    font-weight: 600;\n    color: {{colorSecondary}};\n    margin-bottom: 8pt;\n    text-transform: uppercase;\n    letter-spacing: 0.5pt;\n}\n\n.hero-summary {\n    white-space: pre-line;\n    font-size: 9pt;\n    line-height: 1.3;\n    color: {{colorText}};\n}\n\n.hero-sidebar {\n    display: flex;\n    flex-direction: column;\n    gap: 8pt;\n}\n\n.contact-card {\n    background: #f8fafc;\n    border: 1pt solid #e5e7eb;\n    border-radius: 4pt;\n    padding: 8pt;\n}\n\n.contact-item {\n    margin-bottom: 4pt;\n    font-size: 8pt;\n    color: {{colorText}};\n    display: flex;\n    align-items: center;\n    gap: 4pt;\n}\n\n.contact-item:last-child {\n    margin-bottom: 0;\n}\n\n.contact-icon {\n    font-size: 7pt;\n}\n\n/* Skills Spotlight */\n.skills-spotlight {\n    background: white;\n    padding: 8pt 0;\n    margin-bottom: 10pt;\n    border-bottom: 1pt solid #e5e7eb;\n    page-break-inside: avoid;\n}\n\n.spotlight-title {\n    text-align: center;\n    font-size: 10pt;\n    font-weight: 700;\n    color: {{colorText}};\n    margin-bottom: 6pt;\n    text-transform: uppercase;\n    letter-spacing: 0.5pt;\n}\n\n.skills-showcase {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 4pt;\n}\n\n.skill-badge {\n    background: white;\n    border: 1pt solid #d1d5db;\n    border-radius: 3pt;\n    padding: 3pt 5pt;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n}\n\n.skill-name {\n    font-weight: 600;\n    color: {{colorText}};\n    font-size: 8pt;\n}\n\n.skill-level {\n    font-family: monospace;\n    font-size: 8pt;\n    color: {{colorPrimary}};\n    letter-spacing: 0.3pt;\n}\n\n/* Main Content Grid */\n.content-grid {\n    display: grid;\n    grid-template-columns: 62% 36%;\n    gap: 12pt;\n}\n\n/* Section Styling */\nsection {\n    margin-bottom: 12pt;\n    page-break-inside: avoid;\n}\n\n.section-title {\n    display: flex;\n    align-items: center;\n    gap: 4pt;\n    margin-bottom: 6pt;\n    padding-bottom: 3pt;\n    border-bottom: 1pt solid #e5e7eb;\n}\n\n.title-accent {\n    width: 2pt;\n    height: 12pt;\n    background: {{colorPrimary}};\n    border-radius: 1pt;\n}\n\n.section-title-text {\n    font-size: 9pt;\n    font-weight: 700;\n    color: {{colorText}};\n    text-transform: uppercase;\n    letter-spacing: 0.25pt;\n}\n\n/* Experience Section */\n.job-entry {\n    border-left: 2pt solid #e5e7eb;\n    padding: 6pt 0 6pt 8pt;\n    margin-bottom: 8pt;\n    page-break-inside: avoid;\n}\n\n.job-header {\n    margin-bottom: 2pt;\n}\n\n.job-title {\n    font-weight: 700;\n    color: {{colorPrimary}};\n    font-size: 9pt;\n}\n\n.job-company {\n    font-weight: 600;\n    color: {{colorText}};\n    font-size: 9pt;\n}\n\n.job-period {\n    font-size: 8pt;\n    color: {{colorSecondary}};\n    font-weight: 500;\n    margin-bottom: 4pt;\n}\n\n.job-location {\n    font-size: 8pt;\n    color: {{colorSecondary}};\n    font-style: italic;\n    margin-bottom: 4pt;\n}\n\n.job-description {\n    white-space: pre-line;\n    color: {{colorText}};\n    line-height: 1.3;\n    font-size: 8pt;\n}\n\n/* Education Section */\n.edu-entry {\n    background: white;\n    border: 0.5pt solid #e5e7eb;\n    border-radius: 2pt;\n    padding: 6pt;\n    margin-bottom: 6pt;\n    page-break-inside: avoid;\n}\n\n.edu-degree {\n    font-weight: 700;\n    color: {{colorPrimary}};\n    margin-bottom: 1pt;\n    font-size: 8pt;\n}\n\n.edu-school {\n    font-weight: 600;\n    color: {{colorText}};\n    font-size: 8pt;\n}\n\n.edu-period {\n    color: {{colorSecondary}};\n    font-size: 7pt;\n    margin-bottom: 3pt;\n}\n\n.edu-description {\n    white-space: pre-line;\n    color: {{colorText}};\n    font-size: 7pt;\n    line-height: 1.2;\n    margin-top: 3pt;\n}\n\n/* Certifications */\n.cert-entry {\n    background: #f8fafc;\n    border-radius: 2pt;\n    padding: 4pt;\n    margin-bottom: 3pt;\n    border-left: 2pt solid #3b82f6;\n    page-break-inside: avoid;\n    font-size: 8pt;\n}\n\n.cert-title {\n    color: {{colorPrimary}};\n    font-weight: 700;\n}\n\n.cert-issuer {\n    color: {{colorText}};\n    font-weight: 600;\n}\n\n.cert-date {\n    color: {{colorSecondary}};\n    font-size: 7pt;\n}\n\n.cert-url {\n    color: {{colorSecondary}};\n    font-size: 7pt;\n    word-break: break-all;\n}\n\n.cert-description {\n    white-space: pre-line;\n    display: block;\n    margin-top: 1pt;\n    font-size: 7pt;\n    color: {{colorText}};\n    line-height: 1.2;\n}\n\n/* Languages */\n.languages-list {\n    list-style: none;\n}\n\n.languages-list li {\n    padding: 3pt 0;\n    border-bottom: 0.5pt solid #f3f4f6;\n    font-size: 8pt;\n    color: {{colorText}};\n}\n\n.languages-list li:last-child {\n    border-bottom: none;\n}\n\n/* Interests */\n.interests-tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 2pt;\n}\n\n.tag {\n    background: {{colorBackground}};\n    color: {{colorPrimary}};\n    padding: 2pt 3pt;\n    border-radius: 2pt;\n    font-size: 7pt;\n    font-weight: 500;\n    border: 0.5pt solid {{colorSecondary}};\n}\n\n/* Social Links */\n.social-link {\n    background: #f8fafc;\n    border-radius: 2pt;\n    padding: 4pt 6pt;\n    margin-bottom: 3pt;\n    border-left: 2pt solid {{colorPrimary}};\n    page-break-inside: avoid;\n    font-size: 8pt;\n    display: flex;\n    flex-direction: column;\n    gap: 1pt;\n}\n\n.social-platform {\n    color: {{colorPrimary}};\n    font-weight: 700;\n    font-size: 8pt;\n}\n\n.social-url {\n    color: {{colorSecondary}};\n    font-size: 7pt;\n    word-break: break-all;\n}\n\n/* Page Break Control */\n.hero-section {\n    page-break-after: avoid;\n}\n\n.skills-spotlight {\n    page-break-after: avoid;\n}\n\n.content-grid {\n    page-break-before: avoid;\n}\n\nh1, h2, h3 {\n    page-break-after: avoid;\n}\n\np, li {\n    orphans: 2;\n    widows: 2;\n}",
  "htmlContent": null,
  "previewImageBase64": ""
}